# ============================================
# LAPTOP THEFT MONITOR - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# For Coolify deployment, set these in the Coolify UI

# ============================================
# LAPTOP INFORMATION (Required)
# ============================================
LAPTOP_MODEL=Lenovo Thinkpad T14 GEN 3
LAPTOP_FULL_MODEL=21AH00JJVA
LAPTOP_SERIAL=PF3YR90J
LAPTOP_OS=Windows

# ============================================
# SEARCH CONFIGURATION
# ============================================
# Comma-separated list of keywords to search for
# Leave empty to use defaults
SEARCH_KEYWORDS=Thinkpad T14,T14 Gen 3,T14 GEN 3,21AH00JJVA,Lenovo T14,Thinkpad T14 Gen 3

# Comma-separated list of target locations
# Leave empty to use defaults
TARGET_LOCATIONS=Gia Lai,Kontum,Dak Lak,Daklak,Pleiku,Buon Ma Thuot,Kon Tum

# Comma-separated list of Facebook group URLs (optional)
FACEBOOK_GROUPS=

# ============================================
# MONITORING SETTINGS
# ============================================
# How often to check for new listings (in hours)
CHECK_INTERVAL_HOURS=2

# Maximum results to check per search
MAX_RESULTS_PER_SEARCH=50

# Run browser in headless mode (no window) - set to true for server deployment
HEADLESS_BROWSER=true

# Path to save browser profile (for Facebook login persistence)
BROWSER_PROFILE_PATH=./browser_profile

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# Enable/disable notification channels (true/false)
NOTIFY_CONSOLE=true
NOTIFY_EMAIL=false
NOTIFY_TELEGRAM=false

# ============================================
# EMAIL NOTIFICATION (Optional)
# ============================================
# Only required if NOTIFY_EMAIL=true
# For Gmail: use App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords

EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com

# ============================================
# TELEGRAM NOTIFICATION (Optional)
# ============================================
# Only required if NOTIFY_TELEGRAM=true
#
# To set up Telegram notifications:
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow instructions
# 3. Copy the bot token below
# 4. Message your bot
# 5. Visit: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# 6. Find your chat_id in the response

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For Coolify deployment:
# - Set HEADLESS_BROWSER=true
# - Set notification method (email or telegram recommended)
# - Browser profile will be saved in container volume
# - First run will require manual Facebook login (use docker exec)
